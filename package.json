{
  "name": "hookline",
  "version": "2.4.0",
  "private": true,
  "description": "The Hookline webhook delivery API described in the Hookline documentation.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "hookline": "./bin/hookline.js"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/server.js",
    "dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning --watch src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test",
    "cli": "node --disable-warning=ExperimentalWarning bin/hookline.js"
  },
  "dependencies": {
    "fastify": "^5.12.8"
  }
}
