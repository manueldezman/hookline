# Port the API listens on.
PORT=4242

# Directory that holds the SQLite file.
HOOKLINE_DATA_DIR=./data

# Plan for the demo account. One of free, team, business.
HOOKLINE_PLAN=free

# Keys seeded on first start. Change these before you expose the server.
HOOKLINE_TEST_KEY=hl_test_dev
HOOKLINE_LIVE_KEY=hl_live_dev

# Set to 1 to allow http and private addresses when an endpoint is created.
# Keep it 0 outside local development.
HOOKLINE_ALLOW_PRIVATE_URLS=0
